{
	"$schema": "node_modules/wrangler/config-schema.json",
	"main": ".open-next/worker.js",
	"name": "pa-ordersheet-form",
	"compatibility_date": "2026-05-22",
	"compatibility_flags": [
		"nodejs_compat",
		"global_fetch_strictly_public"
	],
	// 本番の URL（pa-ordersheet-form.<subdomain>.workers.dev）。演者フォームと NodeCG の PA_API_BASE_URL が使うので有効のまま固定する
	"workers_dev": true,
	// バージョンごとのプレビュー URL は使わない。プレビュー版も本番の D1 につながるため、未マージのコードを公開しない。
	// 書かないと wrangler は既存の設定（有効）を変えないので、明示して無効にする
	"preview_urls": false,
	"assets": {
		"directory": ".open-next/assets",
		"binding": "ASSETS"
	},
	"services": [
		{
			// Self-reference service binding, the service name must match the worker name
			// see https://opennext.js.org/cloudflare/caching
			"binding": "WORKER_SELF_REFERENCE",
			"service": "pa-ordersheet-form"
		}
	],
	"images": {
		// Enable image optimization
		// see https://opennext.js.org/cloudflare/howtos/image
		"binding": "IMAGES"
	},
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "pa-ordersheet-form",
			"database_id": "7e1a8781-06ee-4deb-b7c1-dbf19b16c5a7"
		}
	],
	"observability": {
		"enabled": false,
		"head_sampling_rate": 1,
		"logs": {
			"enabled": true,
			"head_sampling_rate": 1,
			"persist": true,
			"invocation_logs": true
		},
		"traces": {
			"enabled": true,
			"persist": true,
			"head_sampling_rate": 1
		}
	}
}