{
  "$id": "band-live/v1/patch-entry-body",
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "expectedRevision": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "bandName": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120
    },
    "initialPerformanceOrder": {
      "anyOf": [
        {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        {
          "type": "null"
        }
      ]
    },
    "cancelled": {
      "type": "boolean"
    }
  },
  "required": [
    "expectedRevision"
  ],
  "additionalProperties": false
}
