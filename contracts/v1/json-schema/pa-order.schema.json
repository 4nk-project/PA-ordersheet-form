{
  "$id": "band-live/v1/pa-order",
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "eventId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,127}$"
    },
    "entryId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,127}$"
    },
    "orderId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,127}$"
    },
    "contentRevision": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "reviewedRevision": {
      "anyOf": [
        {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        {
          "type": "null"
        }
      ]
    },
    "reviewedAt": {
      "anyOf": [
        {
          "type": "string",
          "format": "date-time",
          "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
        },
        {
          "type": "null"
        }
      ]
    },
    "bandName": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120
    },
    "contactName": {
      "type": "string",
      "maxLength": 80
    },
    "microphoneCount": {
      "type": "integer",
      "minimum": 0,
      "maximum": 99
    },
    "usesBackingTrack": {
      "type": "boolean"
    },
    "backingTrack": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "operator": {
              "type": "string",
              "maxLength": 80
            },
            "device": {
              "type": "string",
              "maxLength": 120
            },
            "connection": {
              "type": "string",
              "maxLength": 120
            }
          },
          "required": [
            "operator",
            "device",
            "connection"
          ],
          "additionalProperties": false
        },
        {
          "type": "null"
        }
      ]
    },
    "members": {
      "maxItems": 20,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,127}$"
          },
          "name": {
            "type": "string",
            "maxLength": 80
          },
          "instrument": {
            "type": "string",
            "maxLength": 80
          }
        },
        "required": [
          "id",
          "name",
          "instrument"
        ],
        "additionalProperties": false
      }
    },
    "equipment": {
      "maxItems": 20,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,127}$"
          },
          "name": {
            "type": "string",
            "maxLength": 160
          },
          "instrument": {
            "type": "string",
            "maxLength": 80
          },
          "memberId": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,127}$"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "id",
          "name",
          "instrument",
          "memberId"
        ],
        "additionalProperties": false
      }
    },
    "songs": {
      "maxItems": 30,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,127}$"
          },
          "order": {
            "type": "integer",
            "minimum": 1,
            "maximum": 9007199254740991
          },
          "title": {
            "type": "string",
            "maxLength": 160
          },
          "durationSeconds": {
            "anyOf": [
              {
                "type": "integer",
                "minimum": 0,
                "maximum": 86400
              },
              {
                "type": "null"
              }
            ]
          },
          "mood": {
            "type": "string",
            "maxLength": 80
          },
          "startTrigger": {
            "type": "string",
            "maxLength": 120
          },
          "paRequest": {
            "type": "string",
            "maxLength": 1000
          },
          "mc": {
            "type": "object",
            "properties": {
              "hasMc": {
                "type": "boolean"
              },
              "person": {
                "type": "string",
                "maxLength": 80
              }
            },
            "required": [
              "hasMc",
              "person"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "id",
          "order",
          "title",
          "durationSeconds",
          "mood",
          "startTrigger",
          "paRequest",
          "mc"
        ],
        "additionalProperties": false
      }
    },
    "generalRequest": {
      "type": "string",
      "maxLength": 2000
    },
    "submitterUpdatedAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
    },
    "adminUpdatedAt": {
      "anyOf": [
        {
          "type": "string",
          "format": "date-time",
          "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "eventId",
    "entryId",
    "orderId",
    "contentRevision",
    "reviewedRevision",
    "reviewedAt",
    "bandName",
    "contactName",
    "microphoneCount",
    "usesBackingTrack",
    "backingTrack",
    "members",
    "equipment",
    "songs",
    "generalRequest",
    "submitterUpdatedAt",
    "adminUpdatedAt"
  ],
  "additionalProperties": false
}
