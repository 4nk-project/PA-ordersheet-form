{
	"$schema": "node_modules/wrangler/config-schema.json",
	"main": ".open-next/worker.js",
	"name": "pa-ordersheet-form-circle2",
	"compatibility_date": "2026-05-22",
	"compatibility_flags": [
		"nodejs_compat",
		"global_fetch_strictly_public"
	],
	"assets": {
		"directory": ".open-next/assets",
		"binding": "ASSETS"
	},
	"services": [
		{
			"binding": "WORKER_SELF_REFERENCE",
			"service": "pa-ordersheet-form-circle2"
		}
	],
	"images": {
		"binding": "IMAGES"
	},
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "pa-ordersheet-form-circle2",
			"database_id": "6c17d193-7493-4557-89b6-cdc66f387379"
		}
	]
}
